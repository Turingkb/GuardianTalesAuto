{
  "interface_version": 2,
  "languages": {
    "zh_cn": "assets/interface_zh.json"
  },
  "name": "GuardianTalesAuto",
  "label": "坎公骑冠剑助手",
  "title": "坎公骑冠剑助手 v0.3.0",
  "version": "0.3.0",
  "license": "MIT",
  "controller": [
    {
      "name": "Android",
      "label": "安卓端 (ADB)",
      "description": "通过 ADB 连接安卓真机或模拟器（MuMu/雷电/夜神等）",
      "type": "Adb",
      "display_short_side": 720,
      "display_raw": false
    }
  ],
  "resource": [
    {
      "name": "Main",
      "label": "主资源",
      "path": [
        "resource"
      ],
      "option": [
        "RecognitionInterval"
      ]
    }
  ],
  "task": [
    {
      "name": "启动并返回大厅",
      "entry": "GT_EnsureHub",
      "label": "启动并返回大厅",
      "default_check": true,
      "description": "启动游戏、关闭已识别的公告和推广弹窗，从已支持的页面返回大厅。保留当前游戏进程。"
    },
    {
      "name": "签到检查与领取",
      "entry": "GT_SignIn",
      "label": "签到检查与领取",
      "default_check": true,
      "description": "检查普通签到和已适配的活动签到，尝试领取高亮格；已签到时关闭奖励预览并返回大厅。"
    },
    {
      "name": "公会签到",
      "entry": "GT_GuildSignIn",
      "label": "公会签到",
      "default_check": true,
      "description": "进入公会并领取签到奖励；已签到则直接返回大厅。进入公会可能自动结算赛季排名奖励。"
    },
    {
      "name": "商店每日福利",
      "entry": "GT_ShopBenefits",
      "label": "商店每日福利",
      "default_check": true,
      "description": "领取已订阅签到礼包的日礼及每日免费2000金币。只处理明确的领取或免费按钮。"
    },
    {
      "name": "收取浮游城灵魂点",
      "entry": "GT_CollectSoulPoints",
      "label": "收取浮游城灵魂点",
      "default_check": true,
      "description": "点击可见的灵魂点收取标记，最多30次；已无标记则结束。不会升级建筑。"
    },
    {
      "name": "领取已完成的日常奖励",
      "entry": "GT_DailyRewards",
      "label": "领取已完成的日常奖励",
      "default_check": true,
      "description": "进入日常任务，点击可用的全部领取按钮，关闭奖励弹窗并返回大厅。不会执行战斗。"
    },
    {
      "name": "邮箱自动领取",
      "entry": "GT_MailCollect",
      "label": "邮箱自动领取",
      "default_check": true,
      "description": "领取系统邮件与通知邮件，确认全部领取弹窗并返回大厅。已验证体力和钻石邮件。"
    },
    {
      "name": "好友一键领取与送礼",
      "entry": "GT_FriendGifts",
      "label": "好友一键领取与送礼",
      "default_check": true,
      "description": "领取好友礼物并向现有好友一键送礼。不会添加陌生好友。"
    },
    {
      "name": "觉醒副本免费扫荡",
      "entry": "GT_AwakeningFreeSweep",
      "label": "觉醒副本免费扫荡",
      "default_check": true,
      "description": "最多扫荡剩余3次免费进入机会；免费次数为零时跳过。提交前要求钻石和挑战券消耗都为0。"
    },
    {
      "name": "进化石副本扫荡",
      "entry": "GT_EvolutionSweep",
      "label": "进化石副本扫荡",
      "default_check": false,
      "description": "按设置次数扫荡，支持备用体力。四类副本共用每日10次焕发额度，默认只使用剩余额度；任务顺序决定分配优先级。 自动模式每次扫荡后重新检查已持有英雄，累计1160个或已满星则换目标；无目标则换属性。",
      "option": [
        "EvolutionCount",
        "EvolutionBoost",
        "EvolutionAttribute",
        "EvolutionMode"
      ]
    },
    {
      "name": "金币副本扫荡",
      "entry": "GT_GoldSweep",
      "label": "金币副本扫荡",
      "default_check": false,
      "description": "按设置次数扫荡，支持备用体力。四类副本共用每日10次焕发额度，默认只使用剩余额度；任务顺序决定分配优先级。",
      "option": [
        "GoldCount",
        "GoldBoost"
      ]
    },
    {
      "name": "经验副本扫荡",
      "entry": "GT_ExperienceSweep",
      "label": "经验副本扫荡",
      "default_check": false,
      "description": "按设置次数扫荡，支持备用体力。四类副本共用每日10次焕发额度，默认只使用剩余额度；任务顺序决定分配优先级。",
      "option": [
        "ExperienceCount",
        "ExperienceBoost"
      ]
    },
    {
      "name": "道具副本扫荡",
      "entry": "GT_ItemsSweep",
      "label": "道具副本扫荡",
      "default_check": false,
      "description": "按设置次数扫荡，支持备用体力。四类副本共用每日10次焕发额度，默认只使用剩余额度；任务顺序决定分配优先级。",
      "option": [
        "ItemsCount",
        "ItemsBoost"
      ]
    },
    {
      "name": "打开邮箱（人工）",
      "entry": "GT_OpenMail",
      "label": "打开邮箱（人工）",
      "default_check": false,
      "description": "只打开邮箱并停留，邮件领取请人工操作。"
    },
    {
      "name": "资源与觉醒副本（人工）",
      "entry": "GT_OpenResourceRift",
      "label": "资源与觉醒副本（人工）",
      "default_check": false,
      "description": "打开资源/觉醒副本列表并停留；不点击进入或扫荡，请人工选择副本和次数。"
    },
    {
      "name": "进化石副本（人工）",
      "entry": "GT_OpenEvolutionRift",
      "label": "进化石副本（人工）",
      "default_check": false,
      "description": "打开进化石副本列表并停留；不消耗体力，请人工选择属性、英雄及扫荡次数。"
    },
    {
      "name": "活动页面（人工）",
      "entry": "GT_OpenActivity",
      "label": "活动页面（人工）",
      "default_check": false,
      "description": "只打开活动列表并停留，活动挑战和兑换请人工操作。"
    },
    {
      "name": "日常任务页面（人工）",
      "entry": "GT_OpenDailyTasks",
      "label": "日常任务页面（人工）",
      "default_check": false,
      "description": "只打开日常任务指南并停留，供查看进度或人工执行任务。"
    },
    {
      "name": "冷启动游戏（维护）",
      "entry": "GT_StartUp",
      "label": "冷启动游戏（维护）",
      "default_check": false,
      "description": "停止并重新启动游戏，处理已适配的启动页和弹窗。仅在需要重启时选择。"
    },
    {
      "name": "全屏OCR探测（调试）",
      "entry": "GT_Test_OCRFull",
      "label": "全屏OCR探测（调试）",
      "default_check": false,
      "description": "只识别当前画面文字，不点击游戏界面。结果见框架日志。"
    }
  ],
  "icon": "logo-v2.ico",
  "agent": [
    {
      "child_exec": "C:/Python314/python.exe",
      "child_args": [
        "-u",
        "agent/main.py"
      ]
    }
  ],
  "option": {
    "EvolutionCount": {
      "type": "input",
      "label": "进化石扫荡次数",
      "inputs": [
        {
          "name": "count",
          "label": "次数（0为跳过）",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^(?:[0-9]|[1-9][0-9]|100)$",
          "pattern_msg": "请输入0到100的整数"
        }
      ],
      "pipeline_override": {
        "GT_Sweep_Evolution": {
          "custom_action_param": {
            "count": "{count}"
          }
        }
      }
    },
    "EvolutionBoost": {
      "type": "switch",
      "label": "只扫荡每日焕发次数",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "boost_only": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "否（会继续消耗体力）",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "boost_only": false
              }
            }
          }
        }
      ]
    },
    "GoldCount": {
      "type": "input",
      "label": "金币扫荡次数",
      "inputs": [
        {
          "name": "count",
          "label": "次数（0为跳过）",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^(?:[0-9]|[1-9][0-9]|100)$",
          "pattern_msg": "请输入0到100的整数"
        }
      ],
      "pipeline_override": {
        "GT_Sweep_Gold": {
          "custom_action_param": {
            "count": "{count}"
          }
        }
      }
    },
    "GoldBoost": {
      "type": "switch",
      "label": "只扫荡每日焕发次数",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "GT_Sweep_Gold": {
              "custom_action_param": {
                "boost_only": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "否（会继续消耗体力）",
          "pipeline_override": {
            "GT_Sweep_Gold": {
              "custom_action_param": {
                "boost_only": false
              }
            }
