        }
      ],
      "pipeline_override": {
        "GT_Sweep_Experience": {
          "custom_action_param": {
            "count": "{count}"
          }
        }
      }
    },
    "ExperienceBoost": {
      "type": "switch",
      "label": "只扫荡每日焕发次数",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "GT_Sweep_Experience": {
              "custom_action_param": {
                "boost_only": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "否（会继续消耗体力）",
          "pipeline_override": {
            "GT_Sweep_Experience": {
              "custom_action_param": {
                "boost_only": false
              }
            }
          }
        }
      ]
    },
    "ItemsCount": {
      "type": "input",
      "label": "道具扫荡次数",
      "inputs": [
        {
          "name": "count",
          "label": "次数（0为跳过）",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^(?:[0-9]|[1-9][0-9]|100)$",
          "pattern_msg": "请输入0到100的整数"
        }
      ],
      "pipeline_override": {
        "GT_Sweep_Items": {
          "custom_action_param": {
            "count": "{count}"
          }
        }
      }
    },
    "ItemsBoost": {
      "type": "switch",
      "label": "只扫荡每日焕发次数",
      "default_case": "Yes",
      "cases": [
        {
