              "custom_action_param": {
                "boost_only": false
              }
            }
          }
        }
      ]
    },
    "EvolutionAttribute": {
      "type": "select",
      "label": "起始属性（手动模式为指定属性）",
      "default_case": "neutral",
      "cases": [
        {
          "name": "neutral",
          "label": "虚",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "attribute": "neutral"
              }
            }
          }
        },
        {
          "name": "light",
          "label": "光",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "attribute": "light"
              }
            }
          }
        },
        {
          "name": "dark",
