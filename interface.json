      "label": "经验扫荡次数",
      "inputs": [
        {
          "name": "count",
          "label": "次数（0为跳过）",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^(?:[0-9]|[1-9][0-9]|100)$",
