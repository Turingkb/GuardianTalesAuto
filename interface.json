              }
            }
          }
        },
        {
          "name": "water",
          "label": "水",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "attribute": "water"
              }
            }
          }
        }
      ]
    },
    "EvolutionMode": {
      "type": "select",
      "label": "英雄选择方式",
      "default_case": "auto",
      "cases": [
        {
          "name": "auto",
          "label": "自动选择未刷满的已持有英雄",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "mode": "auto"
              }
            }
          }
        },
        {
          "name": "selected",
          "label": "使用游戏奖励设置中所选英雄",
          "description": "先在游戏相应属性副本的齿轮中选择英雄，再运行此任务。按设置次数刷取，不自动换英雄。",
          "pipeline_override": {
            "GT_Sweep_Evolution": {
              "custom_action_param": {
                "mode": "selected"
              }
            }
          }
        }
      ]
    },
    "RecognitionInterval": {
      "type": "input",
      "label": "识别轮询间隔",
      "description": "单位毫秒；默认100ms，最多约10轮/秒。截图耗时、OCR耗时与动作等待会降低实际频率。GUI画面刷新率在设置→实时画面单独调整。",
      "inputs": [
        {
          "name": "ms",
          "label": "间隔（50～2000ms）",
          "default": "100",
          "pipeline_type": "int",
          "verify": "^(?:[5-9][0-9]|[1-9][0-9]{2}|1[0-9]{3}|2000)$"
        }
      ],
      "pipeline_override": {
        "GT_EnsureHub": {
          "rate_limit": "{ms}"
        },
        "GT_ClearPopups": {
          "rate_limit": "{ms}"
        },
